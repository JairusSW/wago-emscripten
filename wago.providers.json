{
  "$schema": "https://wago.sh/v1/providers.schema.json",
  "providers": [
    {
      "importPath": "github.com/JairusSW/wago-emscripten/register",
      "definition": {
        "id": "github.com/JairusSW/wago-emscripten",
        "name": "Emscripten compatibility runtime",
        "version": "0.4.0",
        "description": "General standalone Emscripten compatibility, plus Go js/wasm and Ruby JS-ABI execution for Wago.",
        "stability": "experimental",
        "compatibility": {
          "engines": {
            "go": "\u003e=1.22",
            "wago": "\u003e=0.1.0"
          },
          "platforms": [
            "darwin/amd64",
            "darwin/arm64",
            "linux/amd64",
            "linux/arm64"
          ]
        },
        "provenance": {
          "homepage": "https://github.com/JairusSW/wago-emscripten#readme",
          "repository": "https://github.com/JairusSW/wago-emscripten",
          "license": "Apache-2.0",
          "authors": [
            "JairusSW"
          ]
        },
        "requires": [
          {
            "id": "github.com/wago-org/wasi/p1",
            "version": "^0.2.1"
          },
          {
            "id": "github.com/wago-org/wasi/unstable",
            "version": "^0.2.1"
          }
        ],
        "authorities": [
          {
            "name": "host.arguments.read",
            "mode": "required",
            "reason": "construct argv for Go js/wasm standalone entry points",
            "scope": {}
          },
          {
            "name": "host.caller.identify",
            "mode": "required",
            "reason": "isolate compatibility state and files by guest instance",
            "scope": {}
          },
          {
            "name": "host.caller.invoke",
            "mode": "required",
            "reason": "run Emscripten and Go js/wasm callbacks on the active guest",
            "scope": {}
          },
          {
            "name": "host.import.define",
            "mode": "required",
            "reason": "define the selected JavaScript-facing host ABIs",
            "scope": {
              "modules": [
                "canonical_abi",
                "env",
                "go",
                "rb-js-abi-host"
              ]
            }
          },
          {
            "name": "instance.close.observe",
            "mode": "required",
            "reason": "release per-instance compatibility state and files",
            "scope": {}
          },
          {
            "name": "module.source.transform",
            "mode": "required",
            "reason": "internalize Emscripten memory and add typed callbacks, heap growth, and standalone launchers",
            "scope": {}
          }
        ],
        "configSchema": {
          "additionalProperties": false,
          "properties": {
            "env": {
              "items": {
                "maxLength": 4096,
                "type": "string"
              },
              "maxItems": 256,
              "type": "array"
            },
            "maxFilesystemBytes": {
              "maximum": 268435456,
              "minimum": 65536,
              "type": "integer"
            },
            "maxOpenFiles": {
              "maximum": 65536,
              "minimum": 3,
              "type": "integer"
            },
            "stderr": {
              "enum": [
                "inherit",
                "discard"
              ],
              "type": "string"
            },
            "stdin": {
              "enum": [
                "inherit",
                "eof"
              ],
              "type": "string"
            },
            "stdout": {
              "enum": [
                "inherit",
                "discard"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "definitionDigest": "sha256:ec6216c95d359be29dd236295ca22883da10bfa974c62849d3ba7196a2bf3609"
    }
  ]
}
